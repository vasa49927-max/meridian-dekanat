# Скопируй в .env и заполни. Файл .env в git не попадает.
DATABASE_URL=postgresql://meridian@localhost:5432/meridian
APP_URL=http://localhost:3000
# Ключ GigaChat API (developers.sber.ru → проект → «Настройки API» → Authorization Key).
# Пусто — помощник работает в режиме поиска по Положению без LLM.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
DEMO_RESET_ENABLED=true
